#!/usr/bin/env bash

set -euo pipefail

readonly VERSION="8.8.1"
readonly CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/whl-fast-lio2"
readonly BAZEL_BIN="${CACHE_DIR}/bazel-${VERSION}"

if command -v bazel >/dev/null 2>&1 &&
   [[ "$(bazel --version)" == "bazel ${VERSION}" ]]; then
  exec bazel "$@"
fi

case "$(uname -m)" in
  x86_64)
    readonly ARCH="x86_64"
    readonly SHA256="5b5bab2095065817d3416ca9a0678bd39c10c9ede432dbe8187bfe74de285160"
    ;;
  aarch64|arm64)
    readonly ARCH="arm64"
    readonly SHA256="41ad5f9e833fcaee7398111343570cb155ca14985abb084b1f0ad2d29eaaec6d"
    ;;
  *)
    echo "Unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

if [[ ! -x "${BAZEL_BIN}" ]]; then
  mkdir -p "${CACHE_DIR}"
  readonly DOWNLOAD="${BAZEL_BIN}.download"
  curl --fail --location --retry 3 --retry-all-errors \
    --output "${DOWNLOAD}" \
    "https://github.com/bazelbuild/bazel/releases/download/${VERSION}/bazel-${VERSION}-linux-${ARCH}"
  echo "${SHA256}  ${DOWNLOAD}" | sha256sum --check -
  chmod +x "${DOWNLOAD}"
  mv "${DOWNLOAD}" "${BAZEL_BIN}"
fi

exec "${BAZEL_BIN}" "$@"
